# =============================================================================
# Biolabs AI Assistant — server-side only (never expose to VITE_* client vars)
# Platform AI (“Use free platform AI”) reads these keys via /api/ai.
# Restart `pnpm dev` after changing keys.
# Verify: with `pnpm dev` running, `pnpm ai:smoke`
# (default http://127.0.0.1:3000 — override with AI_SMOKE_BASE_URL if the port differs).
# Free path: set GEMINI_API_KEY and/or OPENROUTER_API_KEY (either is enough).
# =============================================================================

# Provider selection: auto, gemini, openrouter, or huggingface
AI_PROVIDER=auto

# --- Gemini (recommended free tier via Google AI Studio) ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter (free models / openrouter/free router) ---
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Hugging Face Inference API ---
# Get token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# --- Output limits ---
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=1024

# --- Helix / FDA OpenFDA (server proxy only — never expose to VITE_*) ---
# Get key: https://open.fda.gov/apis/authentication/
FDA_API_KEY=

# Server port (production)
PORT=3000
